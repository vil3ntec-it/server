@echo off
REM ---------------------------------------------------------------------------
REM   اگر نصب‌کننده باز نشد (یا باز شد و بی‌صدا بسته شد)، این فایل را بزنید.
REM   همه‌چیز این‌جا دیده می‌شود؛ اگر خطایی بود، از همین پنجره عکس بگیرید.
REM ---------------------------------------------------------------------------
chcp 65001 >nul 2>nul
cd /d "%~dp0"

echo.
echo   ============================================================
echo     اجرای نصب‌کننده با نمایشِ خطاها
echo     این پنجره را نبندید تا کار تمام شود.
echo   ============================================================
echo.

where powershell >nul 2>nul
if errorlevel 1 (
  echo   PowerShell پیدا نشد. این برنامه فقط روی ویندوز کار می‌کند.
  pause
  exit /b 1
)

powershell -NoProfile -Sta -ExecutionPolicy Bypass -File "homelab-panel\desktop\install.ps1"

echo.
echo   ------------------------------------------------------------
echo   اگر بالا خطایی نوشته شده، از همین پنجره عکس بگیرید و بفرستید.
echo   ------------------------------------------------------------
pause
