<?xml version="1.0" encoding="utf-8"?>
<!--
  سرورِ خانگی روی شبکهٔ خودتان با http و یک IPِ محلی بالا می‌آید
  (مثلاً http://192.168.1.10:4700). اندروید ۹ به بعد http را می‌بندد، و اگر
  این‌جا باز نشود برنامه هیچ‌وقت به سرورِ خودِ شما وصل نمی‌شود.

  ⚠️ فهرستِ ثابتِ دامنه این‌جا جواب نمی‌دهد: IPِ خانه هر جا فرق دارد
  (192.168.x، 10.x، 172.16.x) و کاربر هم ممکن است نامِ محلی بدهد. پس
  cleartext باز است. وقتی از بیرونِ خانه با آدرسِ تونل وصل می‌شوید، آن آدرس
  خودش https است و رمزنگاری سرِ جایش می‌ماند.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true" />
</network-security-config>
