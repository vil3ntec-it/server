<?xml version="1.0" encoding="utf-8"?>
<!-- نگه داشتنِ آیکنِ برنامه روی صفحهٔ گوشی، این دو را نشان می‌دهد.
     صفحهٔ خودِ برنامه تمام‌صفحه می‌ماند و چیزی رویش اضافه نمی‌شود. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
      android:shortcutId="server"
      android:enabled="true"
      android:icon="@mipmap/ic_launcher"
      android:shortcutShortLabel="@string/shortcut_server">
    <intent
        android:action="android.intent.action.MAIN"
        android:targetPackage="ir.vil3ntec.tohid"
        android:targetClass="ir.vil3ntec.tohid.MainActivity">
      <extra android:name="open" android:value="server" />
    </intent>
  </shortcut>

  <shortcut
      android:shortcutId="printer"
      android:enabled="true"
      android:icon="@mipmap/ic_launcher"
      android:shortcutShortLabel="@string/shortcut_printer">
    <intent
        android:action="android.intent.action.MAIN"
        android:targetPackage="ir.vil3ntec.tohid"
        android:targetClass="ir.vil3ntec.tohid.MainActivity">
      <extra android:name="open" android:value="printer" />
    </intent>
  </shortcut>
</shortcuts>
