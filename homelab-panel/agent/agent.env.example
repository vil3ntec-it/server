# ─── Agent سرور — نمونهٔ تنظیمات ──────────────────────────────────────────
# این فایل را به agent.env تغییرِ نام بدهید و مقدارها را بگذارید.

# آدرس Control Center (همان آدرسی که پنل با آن باز می‌شود)
CC_PANEL_URL=https://panel.example.com

# شناسهٔ سرور — در صفحهٔ «سرورها» ی پنل می‌بینید
CC_SERVER_ID=srv_00000000

# کلیدی که پنل هنگام «ساخت کلید» یک‌بار نشان داد
CC_AGENT_KEY=

# هر چند ثانیه گزارش بدهد (پیش‌فرض ۳۰)
CC_INTERVAL=30

# سرویس‌هایی که Agent بازبودنشان را بسنجد: نام:پورت[:میزبان]
# CC_SERVICES=api:3000,websocket:4701,postgres:5432

# آدرس‌هایی که خودِ Agent از داخلِ سرور بسنجد
# CC_HEALTH_HTTP=http://127.0.0.1:3000/health
# CC_HEALTH_WS=ws://127.0.0.1:4701
# CC_TUNNEL_PORT=20241

# اگر پنل گواهی خودامضا دارد (فقط در شبکهٔ داخلی) — 1 بگذارید
# CC_INSECURE=0
