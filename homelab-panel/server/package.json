{
  "name": "homelab-panel-server",
  "version": "1.7.0",
  "private": true,
  "description": "Backend of the home server management panel (Express + Socket.IO + SQLite)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "test": "node test/smoke.mjs && node test/multisite.mjs && node test/protected-domains.mjs && node test/tunnel-recovery.mjs && node test/messenger.mjs && node test/notify.mjs && node test/notify-readkey.mjs && node test/ai-proxy.mjs && node test/app-auth.mjs && node test/storage.mjs && node test/security.mjs",
    "test:multisite": "node test/multisite.mjs",
    "test:ui": "node test/ui.mjs",
    "test:perf": "node test/perf.mjs",
    "test:tunnel": "node test/tunnel.mjs",
    "test:tunnel-recovery": "node test/tunnel-recovery.mjs",
    "test:messenger": "node test/messenger.mjs",
    "test:notify": "node test/notify.mjs",
    "test:notify-readkey": "node test/notify-readkey.mjs",
    "test:app-auth": "node test/app-auth.mjs",
    "test:storage": "node test/storage.mjs && node test/security.mjs",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../desktop/test/lib.tests.ps1",
    "test:pump-notify": "node test/pump-notify.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright-core": "^1.49.1",
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
