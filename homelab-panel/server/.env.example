# این فایل را به .env کپی کنید و در صورت نیاز مقدارها را عوض کنید.

# پورت پنل — سرورِ سایت هم روی همین پورت سوار است
HLP_PORT=4700

# 0.0.0.0 یعنی از کل شبکهٔ خانگی در دسترس باشد
HLP_HOST=0.0.0.0

# محل نگهداری دیتابیس پنل، لاگ‌ها، بکاپ‌ها و دادهٔ سرورِ سایت
# HLP_DATA_DIR=./data

# ریشهٔ سایت‌ها — هر سایت یک پوشهٔ مستقل زیر همین مسیر
# لینوکس: /sites   ویندوز: C:\Users\<user>\sites
# HLP_SITES_ROOT=/sites

# فاصلهٔ ارسال اطلاعات لحظه‌ای (میلی‌ثانیه)
# HLP_METRICS_INTERVAL=2000

# اعتبار توکن ورود (ثانیه)
# HLP_TOKEN_TTL=43200

# حداکثر حجم آپلود در فایل‌منیجر (بایت)
# HLP_MAX_UPLOAD=268435456

# مقصد اندازه‌گیری پینگ (host:port)
# HLP_PING_TARGET=1.1.1.1:443

# ─────────────────────────────────────────────────────────────────────────────
#  زیرساخت: دامنهٔ مرکزی
#  کلاینت‌ها (موبایل/دسکتاپ/وب) فقط همین نام را می‌شناسند، نه IP سرور را.
#  اگر خالی بماند، پنل در «حالتِ شبکهٔ خانگی» بالا می‌آید و مثل قبل کار می‌کند.
# ─────────────────────────────────────────────────────────────────────────────
# HLP_DOMAIN=YOURDOMAIN.com

# زیردامنه‌ها خودکار ساخته می‌شوند: api. / admin. / files. / www.
# فقط اگر نامِ دیگری می‌خواهید این‌ها را بگذارید:
# HLP_API_DOMAIN=api.YOURDOMAIN.com
# HLP_ADMIN_DOMAIN=admin.YOURDOMAIN.com
# HLP_FILES_DOMAIN=files.YOURDOMAIN.com

# آدرسی که به کلاینت‌ها اعلام می‌شود. پیش‌فرض https://api.<دامنه>
# اگر CDN جلوی سرور گذاشتید، آدرسِ CDN را این‌جا بگذارید.
# HLP_API_URL=https://api.YOURDOMAIN.com

# ─────────────────────────────────────────────────────────────────────────────
#  امنیت
# ─────────────────────────────────────────────────────────────────────────────
# فقط وقتی 1 بگذارید که واقعاً یک reverse proxy (Caddy/nginx/Cloudflare) جلوی
# سرور باشد. اگر بی‌جهت روشن باشد، هر کسی با جعلِ هدرِ X-Forwarded-For
# محدودیتِ نرخ را دور می‌زند و لاگ‌ها IPِ دروغ ثبت می‌کنند.
# HLP_TRUST_PROXY=0

# مبدأهای اضافیِ مجاز برای CORS، با کاما جدا. لازم نیست زیردامنه‌های خودتان یا
# شبکهٔ خانگی را این‌جا بنویسید؛ آن‌ها به‌صورت پیش‌فرض مجازند.
# HLP_CORS_ORIGINS=https://app.example.com

# رازِ امضای توکن‌ها. خالی یعنی خودکار ساخته و در دیتابیس نگه داشته شود.
# برای استقرارِ جدی این را بیرون بگذارید: با یک رشتهٔ تصادفیِ بلند پُرش کنید
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ این مقدار هرگز نباید در Git برود.
# HLP_SECRET_KEY=

# سقفِ درخواست در پنجرهٔ زمانی (محدودیتِ نرخ). 0 یعنی خاموش.
# HLP_RATE_LIMIT=600
# HLP_RATE_WINDOW=60

# ─────────────────────────────────────────────────────────────────────────────
#  بکاپ
# ─────────────────────────────────────────────────────────────────────────────
# چند نسخه نگه داشته شود (قدیمی‌ترها خودکار پاک می‌شوند)
# HLP_BACKUP_KEEP=14
# بکاپِ خودکارِ روزانه — برای خاموش کردن 0
# HLP_BACKUP_SCHEDULE=1

# سرورِ سایتِ پمپ یعقوبی روی همین پورت — برای خاموش کردن، 0 بگذارید
# HLP_SITESYNC=1
# رمز سرورِ سایت؛ خالی یعنی خودکار ساخته و در data/site-sync/token.txt نگه داشته شود
# HLP_SITESYNC_TOKEN=

# پورت جداگانه‌ای که **فقط** سرورِ سایت را سرو می‌کند (بدون پنل، بدون فایل‌منیجر).
# تونل اینترنتی همیشه روی همین پورت باز می‌شود تا پنل به بیرون درز نکند.
# HLP_SITESYNC_PORT=4701

# تونل اینترنتی خودکار (cloudflared) — برای خاموش کردن 0 بگذارید
# HLP_TUNNEL=1

# ── دستیارِ پشتیبانیِ هوشمند (پوشهٔ ai-support کنارِ همین پنل) ────────────────
# با بالا آمدنِ پنل خودش روشن می‌شود و اگر افتاد برمی‌گردد. برای خاموش کردن 0.
# HLP_AI_ENABLED=1

# پورتِ محلیِ دستیار. فقط روی 127.0.0.1 گوش می‌دهد و هرگز مستقیم بیرون داده
# نمی‌شود؛ سایت از راهِ /ai/support روی همین پورتِ عمومیِ سرور به آن می‌رسد.
# HLP_AI_PORT=8788

# اگر پوشهٔ ai-support جای دیگری است
# HLP_AI_DIR=

# با گذاشتنِ این رمز، دستیار می‌تواند نشستِ سطحِ مدیر بدهد (جست‌وجوی سراسری و
# مصارف). بدونِ آن همه در سطحِ کاربر می‌مانند.
# HLP_AI_ADMIN_TOKEN=

# مدلی که Ollama باید استفاده کند (اگر خالی بماند، تنظیمِ خودِ ai-support)
# HLP_AI_MODEL=qwen2.5:3b-instruct-q4_K_M
# HLP_AI_OLLAMA_URL=http://127.0.0.1:11434
