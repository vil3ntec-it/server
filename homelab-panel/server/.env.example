# این فایل را به .env کپی کنید و در صورت نیاز مقدارها را عوض کنید.

# پورت پنل — سرورِ سایت هم روی همین پورت سوار است
HLP_PORT=4700

# 0.0.0.0 یعنی از کل شبکهٔ خانگی در دسترس باشد
HLP_HOST=0.0.0.0

# محل نگهداری دیتابیس پنل، لاگ‌ها، بکاپ‌ها و دادهٔ سرورِ سایت
# HLP_DATA_DIR=./data

# ریشهٔ سایت‌ها — هر سایت یک پوشهٔ مستقل زیر همین مسیر
# لینوکس: /sites   ویندوز: C:\Users\<user>\sites
# HLP_SITES_ROOT=/sites

# فاصلهٔ ارسال اطلاعات لحظه‌ای (میلی‌ثانیه)
# HLP_METRICS_INTERVAL=2000

# اعتبار توکن ورود (ثانیه)
# HLP_TOKEN_TTL=43200

# حداکثر حجم آپلود در فایل‌منیجر (بایت)
# HLP_MAX_UPLOAD=268435456

# مقصد اندازه‌گیری پینگ (host:port)
# HLP_PING_TARGET=1.1.1.1:443

# سرورِ سایتِ پمپ یعقوبی روی همین پورت — برای خاموش کردن، 0 بگذارید
# HLP_SITESYNC=1
# رمز سرورِ سایت؛ خالی یعنی خودکار ساخته و در data/site-sync/token.txt نگه داشته شود
# HLP_SITESYNC_TOKEN=

# پورت جداگانه‌ای که **فقط** سرورِ سایت را سرو می‌کند (بدون پنل، بدون فایل‌منیجر).
# تونل اینترنتی همیشه روی همین پورت باز می‌شود تا پنل به بیرون درز نکند.
# HLP_SITESYNC_PORT=4701

# تونل اینترنتی خودکار (cloudflared) — برای خاموش کردن 0 بگذارید
# HLP_TUNNEL=1

# ── دستیارِ پشتیبانیِ هوشمند (پوشهٔ ai-support کنارِ همین پنل) ────────────────
# با بالا آمدنِ پنل خودش روشن می‌شود و اگر افتاد برمی‌گردد. برای خاموش کردن 0.
# HLP_AI_ENABLED=1

# پورتِ محلیِ دستیار. فقط روی 127.0.0.1 گوش می‌دهد و هرگز مستقیم بیرون داده
# نمی‌شود؛ سایت از راهِ /ai/support روی همین پورتِ عمومیِ سرور به آن می‌رسد.
# HLP_AI_PORT=8788

# اگر پوشهٔ ai-support جای دیگری است
# HLP_AI_DIR=

# با گذاشتنِ این رمز، دستیار می‌تواند نشستِ سطحِ مدیر بدهد (جست‌وجوی سراسری و
# مصارف). بدونِ آن همه در سطحِ کاربر می‌مانند.
# HLP_AI_ADMIN_TOKEN=

# مدلی که Ollama باید استفاده کند (اگر خالی بماند، تنظیمِ خودِ ai-support)
# HLP_AI_MODEL=qwen2.5:3b-instruct-q4_K_M
# HLP_AI_OLLAMA_URL=http://127.0.0.1:11434

# ── HTTPS مستقیم روی خودِ پنل (اختیاری) ──────────────────────────────────
# لازم نیست: وقتی پنل از راهِ تونل باز می‌شود، Cloudflare خودش https می‌دهد.
# اگر گواهیِ خودتان را دارید (مثلاً Let's Encrypt) این دو را بگذارید:
# HLP_TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# HLP_TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
# HLP_TLS_CA=
# هر درخواستِ http خودکار به https فرستاده می‌شود (0 برای خاموش کردن)
# HLP_TLS_REDIRECT=1
# HLP_TLS_REDIRECT_PORT=

# ── به‌روزرسانی از GitHub ────────────────────────────────────────────────
# اگر مخزنِ دیگری را دنبال می‌کنید:
# HLP_UPDATE_REPO=vil3ntec-it/server
# اگر چیدمانِ نصب غیرمعمول است:
# HLP_INSTALL_ROOT=
