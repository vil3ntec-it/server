# این فایل را به .env کپی کنید و در صورت نیاز مقدارها را عوض کنید.

# پورت پنل — سرورِ سایت هم روی همین پورت سوار است
HLP_PORT=4700

# 0.0.0.0 یعنی از کل شبکهٔ خانگی در دسترس باشد
HLP_HOST=0.0.0.0

# محل نگهداری دیتابیس پنل، لاگ‌ها، بکاپ‌ها و دادهٔ سرورِ سایت
# HLP_DATA_DIR=./data

# ریشهٔ سایت‌ها — هر سایت یک پوشهٔ مستقل زیر همین مسیر
# لینوکس: /sites   ویندوز: C:\Users\<user>\sites
# HLP_SITES_ROOT=/sites

# فاصلهٔ ارسال اطلاعات لحظه‌ای (میلی‌ثانیه)
# HLP_METRICS_INTERVAL=2000

# اعتبار توکن ورود (ثانیه)
# HLP_TOKEN_TTL=43200

# حداکثر حجم آپلود در فایل‌منیجر (بایت)
# HLP_MAX_UPLOAD=268435456

# مقصد اندازه‌گیری پینگ (host:port)
# HLP_PING_TARGET=1.1.1.1:443

# ─────────────────────────────────────────────────────────────────────────────
#  زیرساخت: دامنهٔ مرکزی
#  کلاینت‌ها (موبایل/دسکتاپ/وب) فقط همین نام را می‌شناسند، نه IP سرور را.
#  اگر خالی بماند، پنل در «حالتِ شبکهٔ خانگی» بالا می‌آید و مثل قبل کار می‌کند.
# ─────────────────────────────────────────────────────────────────────────────
# HLP_DOMAIN=YOURDOMAIN.com

# زیردامنه‌ها خودکار ساخته می‌شوند: api. / admin. / files. / www.
# فقط اگر نامِ دیگری می‌خواهید این‌ها را بگذارید:
# HLP_API_DOMAIN=api.YOURDOMAIN.com
# HLP_ADMIN_DOMAIN=admin.YOURDOMAIN.com
# HLP_FILES_DOMAIN=files.YOURDOMAIN.com

# آدرسی که به کلاینت‌ها اعلام می‌شود. پیش‌فرض https://api.<دامنه>
# اگر CDN جلوی سرور گذاشتید، آدرسِ CDN را این‌جا بگذارید.
# HLP_API_URL=https://api.YOURDOMAIN.com

# ─────────────────────────────────────────────────────────────────────────────
#  امنیت
# ─────────────────────────────────────────────────────────────────────────────
# فقط وقتی 1 بگذارید که واقعاً یک reverse proxy (Caddy/nginx/Cloudflare) جلوی
# سرور باشد. اگر بی‌جهت روشن باشد، هر کسی با جعلِ هدرِ X-Forwarded-For
# محدودیتِ نرخ را دور می‌زند و لاگ‌ها IPِ دروغ ثبت می‌کنند.
# HLP_TRUST_PROXY=0

# مبدأهای اضافیِ مجاز برای CORS، با کاما جدا. لازم نیست زیردامنه‌های خودتان یا
# شبکهٔ خانگی را این‌جا بنویسید؛ آن‌ها به‌صورت پیش‌فرض مجازند.
# HLP_CORS_ORIGINS=https://app.example.com

# رازِ امضای توکن‌ها. خالی یعنی خودکار ساخته و در دیتابیس نگه داشته شود.
# برای استقرارِ جدی این را بیرون بگذارید: با یک رشتهٔ تصادفیِ بلند پُرش کنید
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ این مقدار هرگز نباید در Git برود.
# HLP_SECRET_KEY=

# سقفِ درخواست در پنجرهٔ زمانی (محدودیتِ نرخ). 0 یعنی خاموش.
# HLP_RATE_LIMIT=600
# HLP_RATE_WINDOW=60

# ─────────────────────────────────────────────────────────────────────────────
#  بکاپ
# ─────────────────────────────────────────────────────────────────────────────
# چند نسخه نگه داشته شود (قدیمی‌ترها خودکار پاک می‌شوند)
# HLP_BACKUP_KEEP=14
# بکاپِ خودکارِ روزانه — برای خاموش کردن 0
# HLP_BACKUP_SCHEDULE=1

# سرورِ سایتِ پمپ یعقوبی روی همین پورت — برای خاموش کردن، 0 بگذارید
# HLP_SITESYNC=1
# رمز سرورِ سایت؛ خالی یعنی خودکار ساخته و در data/site-sync/token.txt نگه داشته شود
# HLP_SITESYNC_TOKEN=

# پورت جداگانه‌ای که **فقط** سرورِ سایت را سرو می‌کند (بدون پنل، بدون فایل‌منیجر).
# تونل اینترنتی همیشه روی همین پورت باز می‌شود تا پنل به بیرون درز نکند.
# HLP_SITESYNC_PORT=4701

# تونل اینترنتی خودکار (cloudflared) — برای خاموش کردن 0 بگذارید
# HLP_TUNNEL=1

# ── سرورِ حساب (shop/server) ──────────────────────────────────────────────────
# حساب، اشتراک و پنلِ مدیریتِ همهٔ برنامه‌ها روی سرورِ shop/server است. پنل
# **خودش** آن را بالا می‌آورد (account/supervisor.js): روی PGlite — همان
# PostgreSQL داخلِ Node، با پوشه‌ای در پوشهٔ داده — بی داکر و بی هیچ نصبی.
# پورتِ عمومی هرچه مالِ حساب است (/api/auth، /api/pump، /api/shop، /admin …)
# را از همان درِ api.<دامنه> به آن می‌برد — پس هیچ برنامه‌ای نشانیِ تازه
# نمی‌خواهد. اگر آن سرور جای دیگری است نشانی‌اش را بنویسید؛ «0» خاموشش می‌کند.
# HLP_ACCOUNT_API=http://127.0.0.1:3000

# راه‌اندازیِ خودکارِ سرورِ حساب توسطِ پنل. «0» یعنی خودتان بالا می‌آوریدش
# (داکر یا نصبِ دستی)؛ پنل اگر ببیند از قبل روی همان پورت بالاست، چیزی روشن
# نمی‌کند. کدش: پوشهٔ account-server کنارِ پنل (بستهٔ ویندوز خودش می‌گذارد)،
# یا ریپوی shop کنارِ این ریپو (../shop/server با node_modules)، یا HLP_ACCOUNT_DIR.
# دیتابیس و رازها و مدیرش: <پوشهٔ داده>/account-server/ — با پوشهٔ داده جابه‌جا می‌شود.
# HLP_ACCOUNT_AUTOSTART=1
# HLP_ACCOUNT_DIR=

# نام و رمزِ مدیرِ سرورِ حساب برای پلِ «پمپ‌ها». با سرورِ حسابی که خودِ پنل بالا
# می‌آورد لازم نیست: پنل مدیرش را خودش می‌سازد و با همان وارد می‌شود. فقط اگر
# سرورِ حساب جای دیگری است (HLP_ACCOUNT_AUTOSTART=0) این دو را بدهید — وگرنه
# باید هر دوازده ساعت (عمرِ توکنِ مدیر) در پنل ← پمپ‌ها ← تنظیمات و داده‌ها وارد شوید.
# HLP_ACCOUNT_ADMIN_USER=admin
# HLP_ACCOUNT_ADMIN_PASSWORD=

# ── دستیارِ هوشمند (داخلِ خودِ پنل، صفحهٔ «دستیار هوشمند») ─────────────────
# مغزش Ollama روی همین کامپیوتر است؛ هیچ سرویسِ ابری و هیچ کلیدی لازم نیست.
# 0 = دستیار کلاً از پنل برداشته می‌شود (نه چت، نه گزارش، نه نگهبان)
# HLP_AGENT=1
# نشانیِ Ollama — پیش‌فرض همان نصبِ استاندارد
# HLP_OLLAMA_URL=http://127.0.0.1:11434
# مدل بعد از هر جواب چقدر در رَم بماند (نگهبانِ بی‌کاری خودش بعد از ۳۰ دقیقه بیرونش می‌کند)
# HLP_AGENT_KEEP_ALIVE=10m
# HLP_AGENT_NUM_CTX=8192

# ── HTTPS مستقیم روی خودِ پنل (اختیاری) ──────────────────────────────────
# لازم نیست: وقتی پنل از راهِ تونل باز می‌شود، Cloudflare خودش https می‌دهد.
# اگر گواهیِ خودتان را دارید (مثلاً Let's Encrypt) این دو را بگذارید:
# HLP_TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# HLP_TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
# HLP_TLS_CA=
# هر درخواستِ http خودکار به https فرستاده می‌شود (0 برای خاموش کردن)
# HLP_TLS_REDIRECT=1
# HLP_TLS_REDIRECT_PORT=

# ── به‌روزرسانی از GitHub ────────────────────────────────────────────────
# اگر مخزنِ دیگری را دنبال می‌کنید:
# HLP_UPDATE_REPO=vil3ntec-it/server
# اگر چیدمانِ نصب غیرمعمول است:
# HLP_INSTALL_ROOT=
# ═══════════════════════════════════════════════════════════════════════════
#  ورودِ کاربرانِ برنامه‌ها با کدِ شش‌رقمی (اپِ اندروید، برنامهٔ ویندوز، سایت‌ها)
#
#  تا وقتی هیچ‌کدامِ این‌ها را نگذارید، ورود کار می‌کند ولی کد به‌جای پیامک/ایمیل
#  در «پنل ← لاگ‌ها» و در همان پنجرهٔ سرور نوشته می‌شود (برای آزمایش خوب است).
#  راهنمای زنده و تست:  http://<آدرس سرور>/connect
# ═══════════════════════════════════════════════════════════════════════════

# ── ایمیل (SMTP) ───────────────────────────────────────────────────────────
# جی‌میل: رمزِ عادیِ حساب کار نمی‌کند. در حسابِ گوگل، «تأیید دومرحله‌ای» را روشن
# کنید و بعد یک «App Password» (رمزِ ۱۶ حرفی) بسازید و همان را این‌جا بگذارید.
# OTP_EMAIL_HOST=smtp.gmail.com
# OTP_EMAIL_PORT=465
# OTP_EMAIL_USER=you@gmail.com
# OTP_EMAIL_PASS=xxxxxxxxxxxxxxxx
# OTP_EMAIL_FROM=you@gmail.com
# OTP_EMAIL_FROM_NAME=پمپ یعقوبی
# پورتِ ۵۸۷ هم کار می‌کند؛ آن‌وقت OTP_EMAIL_SECURE=0 بگذارید (خودش STARTTLS می‌کند)
# OTP_EMAIL_SECURE=1

# نام‌های کوتاه‌تر هم پذیرفته می‌شوند و همان کار را می‌کنند. اگر هر دو را
# بگذارید، OTP_EMAIL_* جلوتر است. این‌ها برای نصبِ خودکار (Docker) خوب‌اند،
# جایی که کسی پنل را باز نمی‌کند تا چیزی در آن بنویسد.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SECURE=1
# MAIL_USER=you@gmail.com
# MAIL_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM_ADDRESS=you@gmail.com
# MAIL_FROM_NAME=فروشگاه توحید

# ── پیامک ──────────────────────────────────────────────────────────────────
# یکی از این‌ها: kavenegar | smsir | melipayamak | ghasedak | webhook | none
# OTP_SMS_PROVIDER=kavenegar
# OTP_SMS_KEY=کلیدی که پنلِ پیامک به شما داده
# OTP_SMS_SENDER=شمارهٔ خطِ خودتان
# نامِ «قالبِ تأیید» (کاوه‌نگار: نامِ الگو، sms.ir و ملی‌پیامک: شمارهٔ الگو).
# اگر قالب ندارید خالی بگذارید تا پیامکِ ساده فرستاده شود.
# OTP_SMS_TEMPLATE=

# سرویسِ پیامکِ دیگری دارید؟ با webhook هر سرویسی در دنیا کار می‌کند:
# OTP_SMS_PROVIDER=webhook
# OTP_SMS_URL=https://example.com/api/send
# OTP_SMS_METHOD=POST
# OTP_SMS_HEADERS={"Authorization":"Bearer xyz"}
# OTP_SMS_BODY={"to":"{to0}","text":"{text}"}
#   {to} شمارهٔ جهانی (+98912…) · {to0} شمارهٔ محلی (0912…) · {code} کد · {text} متن

# ── ریزه‌کاری‌ها ────────────────────────────────────────────────────────────
# OTP_APP_NAME=پمپ یعقوبی
# OTP_SMS_TEXT=کد ورود شما: {code}
# OTP_EMAIL_SUBJECT=کد ورود: {code}
# OTP_CODE_LENGTH=6           طولِ کد (۴ تا ۸)
# OTP_CODE_TTL=120            کد چند ثانیه اعتبار دارد
# OTP_RESEND_SECONDS=60       فاصلهٔ دو درخواستِ کد
# OTP_MAX_TRIES=5             چند بار می‌شود کد را غلط زد
# OTP_MAX_PER_HOUR=5          سقفِ کد برای هر شماره در ساعت
# OTP_TOKEN_TTL=2592000       کاربر چند ثانیه وارد بماند (پیش‌فرض ۳۰ روز)
# OTP_DEFAULT_COUNTRY=+98     پیش‌شمارهٔ شماره‌های بدون +

# ⚠️ فقط برای آزمایشِ خودتان: کد را در پاسخِ HTTP هم برمی‌گرداند.
#    روی سرورِ واقعی هرگز روشن نکنید.
# OTP_ECHO=0

# ── HTTPS (اختیاری) ─────────────────────────────────────────────────────────
# اگر گواهیِ واقعی دارید، این دو را بگذارید تا سرور روی https بالا بیاید و
# وب‌سوکت هم wss شود.
#
# ⚠️ گواهیِ خودامضا نسازید: مرورگر و اندروید به آن اعتماد نمی‌کنند و کاربر
#    صفحهٔ «این سایت امن نیست» می‌بیند. برای دسترسی از اینترنت، همان تونل
#    را روشن بگذارید — گواهیِ معتبر دارد و از قبل کار می‌کند.
# HLP_TLS_CERT=C:\certs\server.crt
# HLP_TLS_KEY=C:\certs\server.key

# ── پیدا شدنِ خودکارِ سرور ───────────────────────────────────────────────────
# اپ یک بستهٔ کوچک در شبکه پخش می‌کند و سرور آدرسش را جواب می‌دهد.
# برای خاموش کردن 0 بگذارید.
# HLP_DISCOVERY=1
# HLP_DISCOVERY_PORT=4702

# اعتبارِ بلیتِ وب‌سوکت (میلی‌ثانیه)
# HLP_WS_TICKET_TTL=60000

# فاصلهٔ ضربانِ وب‌سوکت (میلی‌ثانیه)
# HLP_WS_PING_MS=30000
