# این فایل را به .env کپی کنید و در صورت نیاز مقدارها را عوض کنید.

# پورت پنل — سرورِ سایت هم روی همین پورت سوار است
HLP_PORT=4700

# 0.0.0.0 یعنی از کل شبکهٔ خانگی در دسترس باشد
HLP_HOST=0.0.0.0

# محل نگهداری دیتابیس پنل، لاگ‌ها، بکاپ‌ها و دادهٔ سرورِ سایت
# HLP_DATA_DIR=./data

# ریشهٔ سایت‌ها — هر سایت یک پوشهٔ مستقل زیر همین مسیر
# لینوکس: /sites   ویندوز: C:\Users\<user>\sites
# HLP_SITES_ROOT=/sites

# فاصلهٔ ارسال اطلاعات لحظه‌ای (میلی‌ثانیه)
# HLP_METRICS_INTERVAL=2000

# اعتبار توکن ورود (ثانیه)
# HLP_TOKEN_TTL=43200

# حداکثر حجم آپلود در فایل‌منیجر (بایت)
# HLP_MAX_UPLOAD=268435456

# مقصد اندازه‌گیری پینگ (host:port)
# HLP_PING_TARGET=1.1.1.1:443

# سرورِ سایتِ پمپ یعقوبی روی همین پورت — برای خاموش کردن، 0 بگذارید
# HLP_SITESYNC=1
# رمز سرورِ سایت؛ خالی یعنی خودکار ساخته و در data/site-sync/token.txt نگه داشته شود
# HLP_SITESYNC_TOKEN=

# پورت جداگانه‌ای که **فقط** سرورِ سایت را سرو می‌کند (بدون پنل، بدون فایل‌منیجر).
# تونل اینترنتی همیشه روی همین پورت باز می‌شود تا پنل به بیرون درز نکند.
# HLP_SITESYNC_PORT=4701

# تونل اینترنتی خودکار (cloudflared) — برای خاموش کردن 0 بگذارید
# HLP_TUNNEL=1

# ── دستیارِ پشتیبانیِ هوشمند (پوشهٔ ai-support کنارِ همین پنل) ────────────────
# با بالا آمدنِ پنل خودش روشن می‌شود و اگر افتاد برمی‌گردد. برای خاموش کردن 0.
# HLP_AI_ENABLED=1

# پورتِ محلیِ دستیار. فقط روی 127.0.0.1 گوش می‌دهد و هرگز مستقیم بیرون داده
# نمی‌شود؛ سایت از راهِ /ai/support روی همین پورتِ عمومیِ سرور به آن می‌رسد.
# HLP_AI_PORT=8788

# اگر پوشهٔ ai-support جای دیگری است
# HLP_AI_DIR=

# با گذاشتنِ این رمز، دستیار می‌تواند نشستِ سطحِ مدیر بدهد (جست‌وجوی سراسری و
# مصارف). بدونِ آن همه در سطحِ کاربر می‌مانند.
# HLP_AI_ADMIN_TOKEN=

# مدلی که Ollama باید استفاده کند (اگر خالی بماند، تنظیمِ خودِ ai-support)
# HLP_AI_MODEL=qwen2.5:3b-instruct-q4_K_M
# HLP_AI_OLLAMA_URL=http://127.0.0.1:11434

# ── HTTPS مستقیم روی خودِ پنل (اختیاری) ──────────────────────────────────
# لازم نیست: وقتی پنل از راهِ تونل باز می‌شود، Cloudflare خودش https می‌دهد.
# اگر گواهیِ خودتان را دارید (مثلاً Let's Encrypt) این دو را بگذارید:
# HLP_TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# HLP_TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
# HLP_TLS_CA=
# هر درخواستِ http خودکار به https فرستاده می‌شود (0 برای خاموش کردن)
# HLP_TLS_REDIRECT=1
# HLP_TLS_REDIRECT_PORT=

# ── به‌روزرسانی از GitHub ────────────────────────────────────────────────
# اگر مخزنِ دیگری را دنبال می‌کنید:
# HLP_UPDATE_REPO=vil3ntec-it/server
# اگر چیدمانِ نصب غیرمعمول است:
# HLP_INSTALL_ROOT=
# ═══════════════════════════════════════════════════════════════════════════
#  ورودِ کاربرانِ برنامه‌ها با کدِ شش‌رقمی (اپِ اندروید، برنامهٔ ویندوز، سایت‌ها)
#
#  تا وقتی هیچ‌کدامِ این‌ها را نگذارید، ورود کار می‌کند ولی کد به‌جای پیامک/ایمیل
#  در «پنل ← لاگ‌ها» و در همان پنجرهٔ سرور نوشته می‌شود (برای آزمایش خوب است).
#  راهنمای زنده و تست:  http://<آدرس سرور>/connect
# ═══════════════════════════════════════════════════════════════════════════

# ── ایمیل (SMTP) ───────────────────────────────────────────────────────────
# جی‌میل: رمزِ عادیِ حساب کار نمی‌کند. در حسابِ گوگل، «تأیید دومرحله‌ای» را روشن
# کنید و بعد یک «App Password» (رمزِ ۱۶ حرفی) بسازید و همان را این‌جا بگذارید.
# OTP_EMAIL_HOST=smtp.gmail.com
# OTP_EMAIL_PORT=465
# OTP_EMAIL_USER=you@gmail.com
# OTP_EMAIL_PASS=xxxxxxxxxxxxxxxx
# OTP_EMAIL_FROM=you@gmail.com
# OTP_EMAIL_FROM_NAME=پمپ یعقوبی
# پورتِ ۵۸۷ هم کار می‌کند؛ آن‌وقت OTP_EMAIL_SECURE=0 بگذارید (خودش STARTTLS می‌کند)
# OTP_EMAIL_SECURE=1

# ── پیامک ──────────────────────────────────────────────────────────────────
# یکی از این‌ها: kavenegar | smsir | melipayamak | ghasedak | webhook | none
# OTP_SMS_PROVIDER=kavenegar
# OTP_SMS_KEY=کلیدی که پنلِ پیامک به شما داده
# OTP_SMS_SENDER=شمارهٔ خطِ خودتان
# نامِ «قالبِ تأیید» (کاوه‌نگار: نامِ الگو، sms.ir و ملی‌پیامک: شمارهٔ الگو).
# اگر قالب ندارید خالی بگذارید تا پیامکِ ساده فرستاده شود.
# OTP_SMS_TEMPLATE=

# سرویسِ پیامکِ دیگری دارید؟ با webhook هر سرویسی در دنیا کار می‌کند:
# OTP_SMS_PROVIDER=webhook
# OTP_SMS_URL=https://example.com/api/send
# OTP_SMS_METHOD=POST
# OTP_SMS_HEADERS={"Authorization":"Bearer xyz"}
# OTP_SMS_BODY={"to":"{to0}","text":"{text}"}
#   {to} شمارهٔ جهانی (+98912…) · {to0} شمارهٔ محلی (0912…) · {code} کد · {text} متن

# ── ریزه‌کاری‌ها ────────────────────────────────────────────────────────────
# OTP_APP_NAME=پمپ یعقوبی
# OTP_SMS_TEXT=کد ورود شما: {code}
# OTP_EMAIL_SUBJECT=کد ورود: {code}
# OTP_CODE_LENGTH=6           طولِ کد (۴ تا ۸)
# OTP_CODE_TTL=120            کد چند ثانیه اعتبار دارد
# OTP_RESEND_SECONDS=60       فاصلهٔ دو درخواستِ کد
# OTP_MAX_TRIES=5             چند بار می‌شود کد را غلط زد
# OTP_MAX_PER_HOUR=5          سقفِ کد برای هر شماره در ساعت
# OTP_TOKEN_TTL=2592000       کاربر چند ثانیه وارد بماند (پیش‌فرض ۳۰ روز)
# OTP_DEFAULT_COUNTRY=+98     پیش‌شمارهٔ شماره‌های بدون +

# ⚠️ فقط برای آزمایشِ خودتان: کد را در پاسخِ HTTP هم برمی‌گرداند.
#    روی سرورِ واقعی هرگز روشن نکنید.
# OTP_ECHO=0

# ── HTTPS (اختیاری) ─────────────────────────────────────────────────────────
# اگر گواهیِ واقعی دارید، این دو را بگذارید تا سرور روی https بالا بیاید و
# وب‌سوکت هم wss شود.
#
# ⚠️ گواهیِ خودامضا نسازید: مرورگر و اندروید به آن اعتماد نمی‌کنند و کاربر
#    صفحهٔ «این سایت امن نیست» می‌بیند. برای دسترسی از اینترنت، همان تونل
#    را روشن بگذارید — گواهیِ معتبر دارد و از قبل کار می‌کند.
# HLP_TLS_CERT=C:\certs\server.crt
# HLP_TLS_KEY=C:\certs\server.key

# ── پیدا شدنِ خودکارِ سرور ───────────────────────────────────────────────────
# اپ یک بستهٔ کوچک در شبکه پخش می‌کند و سرور آدرسش را جواب می‌دهد.
# برای خاموش کردن 0 بگذارید.
# HLP_DISCOVERY=1
# HLP_DISCOVERY_PORT=4702

# اعتبارِ بلیتِ وب‌سوکت (میلی‌ثانیه)
# HLP_WS_TICKET_TTL=60000

# فاصلهٔ ضربانِ وب‌سوکت (میلی‌ثانیه)
# HLP_WS_PING_MS=30000
