<?xml version="1.0" encoding="utf-8"?>
<!-- Icon inside a settings / option tile: blue when the row is on (activated). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_disabled" />
    <item android:state_activated="true" android:color="@color/sel" />
    <item android:color="@color/text_primary" />
</selector>
