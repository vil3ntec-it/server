<?xml version="1.0" encoding="utf-8"?>
<!-- The one red action: a warm-to-deep red gradient pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_strong">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle"><solid android:color="@color/accent_disabled" /><corners android:radius="@dimen/radius_pill" /></shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle"><solid android:color="@color/accent_pressed" /><corners android:radius="@dimen/radius_pill" /></shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="@color/rec_top" android:endColor="@color/rec_bottom" />
                    <corners android:radius="@dimen/radius_pill" />
                    <stroke android:width="2dp" android:color="@color/focus" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="@color/rec_top" android:endColor="@color/rec_bottom" />
                    <corners android:radius="@dimen/radius_pill" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
