<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="@dimen/radius_pill" />
            <stroke android:width="1.5dp" android:color="@color/stroke" />
            <size android:width="52dp" android:height="32dp" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sel_strong" />
            <corners android:radius="@dimen/radius_pill" />
            <size android:width="52dp" android:height="32dp" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_3" />
            <corners android:radius="@dimen/radius_pill" />
            <stroke android:width="1.5dp" android:color="@color/stroke_strong" />
            <size android:width="52dp" android:height="32dp" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
