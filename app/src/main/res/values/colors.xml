<?xml version="1.0" encoding="utf-8"?>
<!--
  RawRec 1.5 palette. Every colour the app draws comes from here (Kotlin reads R.color.*).
  Surfaces step up in lightness for elevation; red is only for recording and destructive
  actions, blue only for selection / focus / "on".
-->
<resources>
    <!-- surfaces (elevation 0 → 3) -->
    <color name="bg">#FFF3F5FA</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_2">#FFEEF1F7</color>
    <color name="surface_3">#FFE2E7F0</color>
    <color name="surface_pressed">#FFD6DDE9</color>
    <color name="stroke">#FFDDE2EC</color>
    <color name="stroke_strong">#FFC3CBDA</color>

    <!-- text -->
    <color name="text_primary">#FF0E1320</color>
    <color name="text_secondary">#FF4A5468</color>
    <color name="text_tertiary">#FF71798F</color>
    <color name="text_disabled">#FFAEB5C4</color>
    <color name="text_on_light">#FF0A0D14</color>
    <color name="on_accent">#FFFFFFFF</color>

    <!-- primary accent: recording red -->
    <color name="accent">#FFE02A3A</color>
    <color name="accent_fill">#FFE02A3A</color>
    <color name="accent_pressed">#FFB81E2E</color>
    <color name="accent_disabled">#FFF2C2C7</color>
    <color name="accent_soft">#1FE02A3A</color>
    <color name="accent_glow">#33E02A3A</color>

    <!-- secondary accent: selection, focus, "on" -->
    <color name="sel">#FF2F6FE4</color>
    <color name="sel_strong">#FF2F6FE4</color>
    <color name="sel_soft">#1F2F6FE4</color>
    <color name="sel_glow">#142F6FE4</color>

    <!-- status -->
    <color name="success">#FF1DA86B</color>
    <color name="success_soft">#241DA86B</color>
    <color name="warning">#FFD98A00</color>
    <color name="warning_soft">#24D98A00</color>
    <color name="warning_glow">#33D98A00</color>
    <color name="error">#FFD7404A</color>
    <color name="error_soft">#24D7404A</color>
    <color name="info">#FF2F6FE4</color>
    <color name="paused">#FFD98A00</color>

    <!-- interaction -->
    <color name="ripple">#14000000</color>
    <color name="ripple_strong">#26000000</color>
    <color name="ripple_dark">#1F000000</color>
    <color name="focus">#FF2F6FE4</color>
    <color name="transparent">#00000000</color>
    <!-- 6.0: each part of the app has a colour of its own on its tile -->
    <color name="tile_blue">#FF2F6FE4</color>
    <color name="tile_red">#FFE0404C</color>
    <color name="tile_green">#FF1DA86B</color>
    <color name="tile_purple">#FF8A5CF5</color>
    <color name="tile_amber">#FFD98A00</color>
    <color name="tile_cyan">#FF1DA2B5</color>
    <color name="tile_orange">#FFE8692F</color>
    <!-- 6.0: gradients (cards, the stage, the red button) -->
    <color name="card_top">#FFFFFFFF</color>
    <color name="card_bottom">#FFF7F9FD</color>
    <color name="stage_top">#FFFFFFFF</color>
    <color name="stage_bottom">#FFEEF2FA</color>
    <color name="rec_top">#FFFF5260</color>
    <color name="rec_bottom">#FFD92236</color>
    <color name="glow_idle">#0D000000</color>
    <color name="scrim">#80000000</color>
    <color name="pressed_on_light">#FFD9DCE1</color>

    <!-- record dial -->
    <color name="dial_fill">#FFFFFFFF</color>
    <color name="dial_fill_rec">#FFFFE9EB</color>
    <color name="dial_fill_paused">#FFFFF4DE</color>

    <!-- floating control and launcher -->
    <color name="overlay_bg">#F2FFFFFF</color>
    <color name="launcher_bg">#FFE0293A</color>
    <color name="launcher_bg_top">#FFFF4D58</color>
    <color name="launcher_bg_bottom">#FFD41F31</color>
</resources>
