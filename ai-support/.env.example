# ═══════════════════════════════════════════════════════════════════════════
#  دستیارِ پشتیبانی — نمونهٔ فایلِ محیط
#  این فایل را کپی کن به نامِ  .env  و پر کن. همه‌چیز اختیاری است؛ سرویس بدونِ
#  هیچ‌کدام هم بالا می‌آید (در حالتِ «فقط بازیابی»).
#
#  ⚠️ رمزها فقط این‌جا. هیچ رمزی داخلِ کد یا داخلِ Knowledge Base نوشته نشود —
#     اگر بنویسی، لایهٔ redact جلوی نمایشش را می‌گیرد ولی از اول اشتباه است.
# ═══════════════════════════════════════════════════════════════════════════

# ── شبکه ────────────────────────────────────────────────────────────────────
AI_PORT=8788
# فقط روی خودِ دستگاه گوش بدهد. اگر می‌خواهی از شبکهٔ خانه هم برسند: 0.0.0.0
AI_HOST=127.0.0.1
# دامنه‌هایی که اجازهٔ صدا زدنِ سرویس را دارند (با کاما جدا). خالی = فقط same-origin
AI_ALLOWED_ORIGINS=https://yaqobipump.top,http://localhost:8080

# ── احراز هویت ──────────────────────────────────────────────────────────────
# رمزِ امضای نشست. اگر خالی بماند، موقعِ اجرا یکی ساخته و در data/session-key.txt
# ذخیره می‌شود. برای محیطِ جدی خودت بگذار (دستِ‌کم ۳۲ نویسه).
AI_SESSION_SECRET=
# رمزی که برنامهٔ اصلی هنگام گرفتنِ نشست نشان می‌دهد. اگر خالی بماند، همان توکنِ
# داخلیِ برنامه پذیرفته می‌شود (تا کاربر مجبور به تنظیم نباشد).
AI_APP_TOKEN=

# ── مدل ─────────────────────────────────────────────────────────────────────
# ollama | openai-compat | none
AI_LLM_PROVIDER=ollama
AI_OLLAMA_URL=http://127.0.0.1:11434
# با  node bin/detect-hardware.mjs  مدلِ مناسبِ سخت‌افزارت را پیشنهاد می‌دهد
AI_LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
AI_EMBED_MODEL=nomic-embed-text

# اگر می‌خواهی از سرویسِ ابری استفاده کنی (پیش‌فرض: نه)
# AI_LLM_PROVIDER=openai-compat
# AI_OPENAI_BASE_URL=https://api.example.com/v1
# AI_OPENAI_API_KEY=
# AI_OPENAI_MODEL=

# ── ترمزهای بار (این‌ها هستند که نمی‌گذارند کامپیوتر داغ کند) ────────────────
# چند تولیدِ هم‌زمان. روی کامپیوترِ خانگی همیشه ۱ بگذار.
AI_MAX_CONCURRENT=1
# بیشتر از این در صف نماند؛ بقیه جوابِ استخراجی می‌گیرند
AI_MAX_QUEUE=8
# پنجرهٔ متنِ مدل — کوچک یعنی سریع و کم‌مصرف
AI_NUM_CTX=2048
# سقفِ طولِ جواب
AI_MAX_TOKENS=400
# بعد از این مدت بیکاری، مدل از رَم بیرون می‌رود
AI_KEEP_ALIVE=5m
# اگر میانگینِ بارِ سیستم به‌ازای هر هسته از این بیشتر شد → حالتِ «فقط بازیابی»
AI_LOAD_LIMIT=0.85
