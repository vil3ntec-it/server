# دامنهٔ اصلی — زیردامنه‌های api/admin/files/www خودکار از آن ساخته می‌شوند
DOMAIN=YOURDOMAIN.com

# ایمیل برای هشدارهای انقضای گواهیِ Let's Encrypt
ACME_EMAIL=you@example.com

# ⚠️ رازِ امضای توکن‌ها. حتماً عوضش کنید و هرگز در Git نگذارید:
#     openssl rand -hex 32
SECRET_KEY=

# ریشهٔ سایت‌ها روی خودِ میزبان
SITES_ROOT=./sites

# چند نسخه بکاپ نگه داشته شود
BACKUP_KEEP=14
