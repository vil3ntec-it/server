# دامنهٔ اصلی — زیردامنه‌های api/admin/files/www خودکار از آن ساخته می‌شوند
DOMAIN=YOURDOMAIN.com

# ایمیل برای هشدارهای انقضای گواهیِ Let's Encrypt
ACME_EMAIL=you@example.com

# ⚠️ رازِ امضای توکن‌ها. حتماً عوضش کنید و هرگز در Git نگذارید:
#     openssl rand -hex 32
SECRET_KEY=

# ریشهٔ سایت‌ها روی خودِ میزبان
SITES_ROOT=./sites

# چند نسخه بکاپ نگه داشته شود
BACKUP_KEEP=14

# ═══════════════════════════════════════════════════════════════════════════
#  ورودِ کاربرانِ اپِ اندروید با کدِ شش‌رقمی
#
#  تا وقتی هیچ‌کدام را نگذارید، ورود کار می‌کند ولی کد به‌جای پیامک/ایمیل در
#  «پنل ← لاگ‌ها» نوشته می‌شود. برای آزمایش خوب است، برای کاربرِ واقعی نه.
#  یکی از دو گروهِ زیر کافی است؛ هر دو با هم هم می‌شود.
# ═══════════════════════════════════════════════════════════════════════════

# ── پیامک ──────────────────────────────────────────────────────────────────
# kavenegar | smsir | melipayamak | ghasedak | webhook | none
# OTP_SMS_PROVIDER=kavenegar
# OTP_SMS_KEY=کلیدی که پنلِ پیامک داده
# OTP_SMS_SENDER=شمارهٔ خطِ خودتان
# نامِ «قالبِ تأیید» — خالی یعنی پیامکِ ساده
# OTP_SMS_TEMPLATE=

# ── ایمیل ──────────────────────────────────────────────────────────────────
# جی‌میل: رمزِ عادیِ حساب کار نمی‌کند. «تأیید دومرحله‌ای» را روشن کنید و یک
# App Password شانزده‌حرفی بسازید.
# OTP_EMAIL_HOST=smtp.gmail.com
# OTP_EMAIL_PORT=465
# OTP_EMAIL_USER=you@gmail.com
# OTP_EMAIL_PASS=xxxxxxxxxxxxxxxx
# OTP_EMAIL_FROM_NAME=پمپ یعقوبی

# نامی که در متنِ پیامک و ایمیل می‌آید
# OTP_APP_NAME=پمپ یعقوبی

# ⚠️ فقط برای آزمایشِ خودتان: کد را در پاسخِ HTTP هم برمی‌گرداند.
#    روی سرورِ واقعی هرگز روشن نکنید.
# OTP_ECHO=0

# ── دستیارِ هوشمند ─────────────────────────────────────────────────────────
# در این مسیر خاموش است (پوشهٔ ai-support داخلِ ایمیج نیست). ۱ نکنید مگر
# اینکه Dockerfile را هم عوض کرده باشید.
# AI_ENABLED=0
