# ---------------------------------------------------------------------------
#  تنظیماتِ VILL3N روی VPS با داکر — این فایل را .env بنامید و پر کنید.
#  ⛔ .env رازها را دارد: chmod 600 .env — و هرگز در گیت نگذارید.
#  شرحِ هر خط: docs/DEPLOY-ANYWHERE-fa.md
# ---------------------------------------------------------------------------

# ── دامنه ────────────────────────────────────────────────────────────────────
# برنامه‌ها به api.<دامنه> و اپِ مدیر به admin.<دامنه> وصل می‌شوند.
# در DNS برای هر دو یک رکوردِ A به IPِ همین سرور بسازید (ابرِ نارنجیِ Cloudflare خاموش).
HLP_DOMAIN=example.com

# ── مدیرِ پنل (فقط بارِ اول ساخته می‌شود؛ بعد از پنل عوضش کنید) ───────────────
HLP_ADMIN_USER=admin
# دستِ‌کم ۱۲ نویسه:  openssl rand -base64 18
HLP_ADMIN_PASSWORD=
# رازِ نشست‌های پنل:  openssl rand -hex 32
HLP_SECRET_KEY=

# ── پنل از اینترنت؟ (پیش‌فرض: نه — ورود با تونلِ SSH) ─────────────────────────
# برای باز کردنش روی panel.<دامنه>: سه خطِ زیر را باز کنید و CADDYFILE را عوض کنید.
# ورود از این راه فقط با کدِ دومرحله‌ای (TOTP) است؛ اول از تونلِ SSH روشنش کنید.
# HLP_PANEL_PUBLIC=1
# HLP_PANEL_URL=https://panel.example.com
# PANEL_HOST=panel.example.com
CADDYFILE=Caddyfile

# ── سرورِ حساب (فروشگاه و اشتراک‌ها) ────────────────────────────────────────
# پیش‌فرض: داخلِ همین کانتینر، روی PGlite در volumeِ panel-data — مثلِ خانه.
# شاخهٔ ریپوی shop که در ایمیج می‌نشیند:
SHOP_REF=main
# اگر سرورِ حساب جای دیگری است (PostgreSQL، هاستِ اشتراکی، PaaS):
# HLP_ACCOUNT_API=https://shop.example.com
# HLP_ACCOUNT_ADMIN_USER=admin
# HLP_ACCOUNT_ADMIN_PASSWORD=
# HLP_ACCOUNT_AUTOSTART=0

# ── پشتیبانِ بیرون از سرور (بندِ ۷) ─────────────────────────────────────────
# هر پشتیبان رمزشده در صف می‌نشیند و با rclone می‌رود. نمونه برای S3/R2/B2:
# HLP_OFFSITE_REMOTE=offsite:vill3n-backups
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ── قابلیت‌های «فقط خانه» — پیش‌فرض خاموش؛ فقط آگاهانه ──────────────────────
# HLP_FEATURE_TERMINAL=0
# HLP_FEATURE_FILES=0
# HLP_FEATURE_DATABASES=0
# HLP_FEATURE_SITES=0
# HLP_FEATURE_AGENT=0

# ── پیشرفته ──────────────────────────────────────────────────────────────────
# PANEL_LOCAL_PORT=4700
# API_HOST=api.example.com
# ADMIN_HOST=admin.example.com
